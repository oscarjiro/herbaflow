  "components": {
    "schemas": {
      "AnalysisCreate": {
        "properties": {
          "analysis_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Name"
          },
          "plant_input_mode": {
            "$ref": "#/components/schemas/PlantInputMode",
            "default": "selection"
          },
          "disease_input_mode": {
            "$ref": "#/components/schemas/DiseaseInputMode",
            "default": "selection"
          },
          "plant_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Plant Ids"
          },
          "disease_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disease Id"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode",
            "default": "guided"
          },
          "manual_compound_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Manual Compound Ids"
          },
          "manual_target_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Manual Target Ids"
          },
          "manual_disease_target_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Manual Disease Target Ids"
          },
          "plant_label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Plant Label"
          },
          "disease_label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Disease Label"
          },
          "parameters": {
            "anyOf": [
              {
                "additionalProperties": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameters",
            "description": "Per-group parameter overrides for any pipeline group (adme / target / disease_targets / ppi / hub_genes / enrichment); validated against the contract hard bounds at create, merged over the group defaults, and frozen as the run baseline."
          }
        },
        "type": "object",
        "title": "AnalysisCreate"
      },
      "AnalysisRead": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "format": "uuid",
            "title": "Analysis Id"
          },
          "analysis_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],

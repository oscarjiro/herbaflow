{
  "openapi": "3.1.0",
  "info": {
    "title": "Herbaflow API",
    "version": "0.1.0"
  },
  "paths": {
    "/diseases": {
      "get": {
        "tags": [
          "diseases"
        ],
        "summary": "List Diseases",
        "operationId": "list_diseases",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DiseaseRead"
                  },
                  "type": "array",
                  "title": "Response List Diseases"
                }
              }
            }
          }
        }
      }
    },
    "/plants": {
      "get": {
        "tags": [
          "plants"
        ],
        "summary": "List Plants",
        "operationId": "list_plants",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PlantRead"
                  },
                  "type": "array",
                  "title": "Response List Plants"
                }
              }
            }
          }
        }
      }
    },
    "/analyses": {
      "post": {
        "tags": [
          "analyses"
        ],
        "summary": "Create Analysis",
        "operationId": "create_analysis",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analyses/{analysis_id}": {
      "get": {
        "tags": [
          "analyses"
        ],
        "summary": "Get Analysis",
        "operationId": "get_analysis",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analyses/{analysis_id}/advance": {
      "post": {
        "tags": [
          "analyses"
        ],
        "summary": "Advance Analysis",
        "operationId": "advance_analysis",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness probe reporting service status.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisCreate": {
        "properties": {
          "analysis_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Name"
          },
          "plant_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Plant Ids"
          },
          "disease_id": {
            "type": "string",
            "format": "uuid",
            "title": "Disease Id"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "plant_ids",
          "disease_id"
        ],
        "title": "AnalysisCreate"
      },
      "AnalysisRead": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "format": "uuid",
            "title": "Analysis Id"
          },
          "analysis_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Name"
          },
          "disease_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disease Id"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "current_stage": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Stage"
          },
          "stage_results": {
            "additionalProperties": true,
            "type": "object",
            "title": "Stage Results"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          }
        },
        "type": "object",
        "required": [
          "analysis_id",
          "analysis_name",
          "disease_id",
          "mode",
          "status",
          "current_stage",
          "stage_results",
          "created_at",
          "completed_at",
          "expires_at",
          "error_message"
        ],
        "title": "AnalysisRead"
      },
      "DiseaseRead": {
        "properties": {
          "disease_id": {
            "type": "string",
            "format": "uuid",
            "title": "Disease Id"
          },
          "canonical_key": {
            "type": "string",
            "title": "Canonical Key"
          },
          "disease_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disease Name"
          },
          "ontology_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ontology Id"
          },
          "ontology_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ontology Source"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "retrieved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieved At"
          }
        },
        "type": "object",
        "required": [
          "disease_id",
          "canonical_key",
          "disease_name",
          "ontology_id",
          "ontology_source",
          "source_url",
          "retrieved_at"
        ],
        "title": "DiseaseRead"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Mode": {
        "type": "string",
        "enum": [
          "auto",
          "guided"
        ],
        "title": "Mode"
      },
      "PlantRead": {
        "properties": {
          "plant_id": {
            "type": "string",
            "format": "uuid",
            "title": "Plant Id"
          },
          "canonical_key": {
            "type": "string",
            "title": "Canonical Key"
          },
          "canonical_scientific_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Scientific Name"
          },
          "family_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family Name"
          }
        },
        "type": "object",
        "required": [
          "plant_id",
          "canonical_key",
          "canonical_scientific_name",
          "family_name"
        ],
        "title": "PlantRead"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
